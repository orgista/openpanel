#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
quest_root="$(cd "$script_dir/.." && pwd)"

default_build_root="${TMPDIR:-/tmp}/openpanel-quest-build"
default_project_cache="${TMPDIR:-/tmp}/openpanel-quest-gradle-cache"

export OPENPANEL_GRADLE_BUILD_ROOT="${OPENPANEL_GRADLE_BUILD_ROOT:-$default_build_root}"

if [[ -z "${JAVA_HOME:-}" && -x /usr/libexec/java_home ]]; then
  if JAVA_HOME="$("/usr/libexec/java_home" -v 21 2>/dev/null)"; then
    export JAVA_HOME
  elif JAVA_HOME="$("/usr/libexec/java_home" -v 17 2>/dev/null)"; then
    export JAVA_HOME
  else
    unset JAVA_HOME
  fi
fi

project_cache="${OPENPANEL_GRADLE_PROJECT_CACHE:-$default_project_cache}"
mkdir -p "$OPENPANEL_GRADLE_BUILD_ROOT" "$project_cache"

if [[ $# -eq 0 ]]; then
  set -- app:testDebugUnitTest app:assembleDebug
fi

exec "$quest_root/gradlew" \
  -p "$quest_root" \
  --project-cache-dir "$project_cache" \
  --no-watch-fs \
  "$@"
