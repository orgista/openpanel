<?xml version="1.0" encoding="utf-8"?>
<!-- Fully transparent splash icon. Android 12+ shows the launcher icon on the
     system splash by default; pointing the animated icon at this blank drawable
     suppresses the logo mark so the cold start is a plain dark frame that hands
     off to the in-app wordmark launch animation. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size
        android:width="1dp"
        android:height="1dp" />
</shape>
