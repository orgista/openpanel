<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ uses the approved OpenPanel Quad launcher mark. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">@color/openpanel_launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@color/openpanel_launch_background</item>
    </style>
</resources>
