<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: force a black, icon-less launch frame so no
         logo or splash card ever appears when the kiosk cold-starts on wake. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:background">@android:color/black</item>
    </style>
</resources>
